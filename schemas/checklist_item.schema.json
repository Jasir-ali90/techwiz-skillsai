{
  "$id": "https://skillsprint.ai/schemas/ChecklistItemOut",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity": {
      "title": "Activity",
      "type": "string"
    },
    "due_stage": {
      "description": "Onboarding stage code, e.g. WEEK_1",
      "title": "Due Stage",
      "type": "string"
    },
    "is_required": {
      "title": "Is Required",
      "type": "boolean"
    },
    "mandatory": {
      "title": "Mandatory",
      "type": "boolean"
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "Priority",
      "type": "string"
    },
    "requirement_code": {
      "description": "Matrix requirement code, e.g. R012",
      "title": "Requirement Code",
      "type": "string"
    },
    "responsible_person": {
      "description": "Employee, Manager, Buddy, IT, HR ...",
      "title": "Responsible Person",
      "type": "string"
    },
    "source_chunk_code": {
      "description": "Chunk code, e.g. POL-INFOSEC-001#C004",
      "title": "Source Chunk Code",
      "type": "string"
    },
    "source_document_id": {
      "description": "UUID of the cited document version",
      "title": "Source Document Id",
      "type": "string"
    },
    "source_section_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Section id inside the document, e.g. 2.3",
      "title": "Source Section Id"
    }
  },
  "required": [
    "requirement_code",
    "source_document_id",
    "source_section_id",
    "source_chunk_code",
    "mandatory",
    "priority",
    "due_stage",
    "activity",
    "is_required",
    "responsible_person"
  ],
  "title": "ChecklistItemOut",
  "type": "object"
}
