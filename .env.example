# Copy to .env and fill in. Never commit .env; every secret comes from the environment.

DATABASE_URL=postgresql+asyncpg://skillsprint:skillsprint@localhost:5432/skillsprint
APP_ENV=development
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=25
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pipeline 1 primary provider: "anthropic" (needs GENAI_API_KEY), "gemini" (free tier; GEMINI_API_KEY or
# GENAI_API_KEY), "groq", "openrouter", "ollama" (local), or "offline" (deterministic, no key, no cost).
GENAI_PROVIDER=offline
GENAI_API_KEY=
# Empty means the default (claude-opus-5) when GENAI_PROVIDER=anthropic.
GENAI_MODEL=

# Free fallback: Google Gemini. Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
# Empty means config/generation.yaml (gemini-3.8-flash).
GEMINI_MODEL=
# Other OpenAI-compatible fallbacks (optional).
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Order tried after GENAI_PROVIDER. Empty = config/generation.yaml fallback_chain (gemini, offline); "none" disables.
GENAI_FALLBACK_PROVIDERS=

# Seeded logins (override in production).
SEED_ADMIN_PASSWORD=Admin@123
SEED_EVALUATOR_PASSWORD=Evaluate@123

# Docker entrypoint: load the Nexora Labs demo corpus on start, optionally with plans.
BOOTSTRAP_DEMO=true
BOOTSTRAP_PLANS=false

# Local LLM fallback (docker compose --profile llm up -d). Ollama needs no key; OLLAMA_API_KEY is only
# for an auth proxy in front of it. Empty values use config/generation.yaml (localhost:11434, qwen2.5:3b).
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=
